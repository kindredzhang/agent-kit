{
  "name": "agent-kit",
  "version": "0.1.0",
  "description": "Vendor-agnostic agent loop for TypeScript: tools, approvals, durable runs, evals.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kindredzhang/agent-kit.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "GLOSSARY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run tsc --noEmit",
    "build": "rm -rf dist && bunx tsc -p tsconfig.build.json",
    "verify-package": "bun run build && bun run scripts/verify-package.ts",
    "examples": "bun run examples/run-all.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run verify-package"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "@opentelemetry/api": ">=1.9",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/bun": "latest",
    "openai": "^7.63.0",
    "typescript": "^5.9.3"
  }
}
